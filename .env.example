# Keep the current active origin here until turntune.app DNS and auth callbacks are ready.
APP_ORIGIN=https://turntune.app
# Optional additional approved HTTPS origins, comma-separated; keep old domains here during migration.
APP_ORIGINS=
# Exact reverse-proxy IPs/CIDRs only. Empty trusts nobody and refuses proxied HTTP.
# Do not use this example subnet without verifying your real ingress topology.
TRUSTED_PROXY_CIDRS=
CSP_MODE=enforce
# Compose exposes the backend on loopback only; terminate TLS at your ingress.
SOUNDSPIN_PORT=3000
# Set to the reviewed Git revision when building a deployable image.
SOUNDSPIN_REVISION=unknown
# Error/log adapter: none, console, or sentry.
OBSERVABILITY_PROVIDER=console
# Set staging on the staging service; settings are read at runtime.
OBSERVABILITY_ENVIRONMENT=production
OBSERVABILITY_TRACES_SAMPLE_RATE=0.1
# Separate Sentry projects for server and browser; browser DSN is public.
SENTRY_DSN=
SENTRY_BROWSER_DSN=
# Optional server-only OTLP HTTP export; endpoint is the base URL, without /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional comma-separated key=value exporter headers; keep credentials server-only.
OTEL_EXPORTER_OTLP_HEADERS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Inline SUPABASE_JWKS is for isolated tests only; leave it unset in production.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SIGNUP_INVITE_PASSWORD=replace-with-a-long-random-invite-password
SOUNDCLOUD_CLIENT_ID=your-soundcloud-client-id
SOUNDCLOUD_CLIENT_SECRET=your-soundcloud-client-secret
# Public catalog and stream access. Never use VITE_ variables for provider credentials.
AUDIUS_API_KEY=your-audius-api-key
# Optional server-only token; public Audius playback does not use it.
AUDIUS_API_BEARER_TOKEN=
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://turntune.app/api/spotify/callback
# For local development, register/use http://127.0.0.1:5173/api/spotify/callback instead.
SPOTIFY_MARKET=US
PROVIDER_TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret
APPLE_MUSIC_TEAM_ID=your-apple-developer-team-id
APPLE_MUSIC_KEY_ID=your-music-key-id
APPLE_MUSIC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APPLE_MUSIC_STOREFRONT=us
GIPHY_API_KEY=your-giphy-api-key
YOUTUBE_API_KEY=your-youtube-data-api-key
# Process-wide provider admission; tune after measured staging playback/load.
PROVIDER_REQUESTS_PER_MINUTE=300
SPOTIFY_REQUESTS_PER_MINUTE=1200
PROVIDER_MAX_CONCURRENT=12
PROVIDER_GLOBAL_MAX_CONCURRENT=48
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
