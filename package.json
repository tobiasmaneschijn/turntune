{
  "name": "turntune",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/start-development.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/start-production.js",
    "test": "node scripts/run-tests.mjs",
    "test:sql": "node scripts/run-tests.mjs sql",
    "test:production": "node scripts/run-tests.mjs production",
    "test:signup": "node scripts/run-tests.mjs signup",
    "test:chat": "node scripts/run-tests.mjs chat",
    "test:feedback": "node scripts/run-tests.mjs feedback",
    "test:giphy": "node scripts/run-tests.mjs giphy",
    "test:radio": "node scripts/run-tests.mjs radio",
    "test:soundcloud": "node scripts/run-tests.mjs soundcloud",
    "test:music": "node scripts/run-tests.mjs music",
    "test:playback": "node scripts/run-tests.mjs playback",
    "test:ui:playback": "node scripts/run-browser-tests.mjs playback",
    "test:ui:music-qol": "node scripts/run-browser-tests.mjs music-qol",
    "test:ui:player-qol": "node scripts/run-browser-tests.mjs player-qol",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:ui": "node scripts/run-browser-tests.mjs ui",
    "test:ui:behavior": "node scripts/run-browser-tests.mjs behavior --workers=1",
    "test:ui:live": "playwright test --config=playwright.live.config.ts",
    "test:ui:fixtures": "node scripts/run-browser-tests.mjs fixtures",
    "test:users:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.test-users.local scripts/seed-test-users.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "audit:dependencies": "node scripts/check-dependencies.mjs",
    "security:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.110.7",
    "@twemoji/api": "^17.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "express": "^5.3.0",
    "i18next": "^26.5.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "proxy-addr": "^2.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.1.0",
    "react-resizable-panels": "^4.12.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.13",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  }
}
