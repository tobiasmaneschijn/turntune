{
  "name": "soundspin",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test tests/*.test.ts server/*.test.ts",
    "test:sql": "node --test tests/*-rls.test.mjs tests/sql/check-chat-rls.mjs",
    "test:production": "node --test tests/production-entrypoint-smoke.mjs",
    "test:signup": "tsx --test server/invite-signup.test.ts",
    "test:chat": "tsx --test tests/chat-*.test.ts",
    "test:feedback": "tsx --test tests/feedback-diagnostics.test.ts tests/feedback-agent-prompt.test.ts",
    "test:giphy": "tsx --test server/giphy.test.ts",
    "test:radio": "tsx --test server/radio.test.ts server/store.test.ts",
    "test:soundcloud": "tsx --test server/soundcloud.test.ts",
    "test:music": "tsx --test server/music.test.ts",
    "test:playback": "tsx --test tests/playback-*.test.ts tests/player-api-loader.test.ts",
    "test:ui:playback": "playwright test --config=playwright.playback.config.ts",
    "test:ui:music-qol": "playwright test --config=playwright.music-qol.config.ts",
    "test:ui:player-qol": "playwright test --config=playwright.player-qol.config.ts",
    "test:integration": "tsx --test tests/server-integration.test.ts",
    "test:ui": "playwright test",
    "test:ui:behavior": "playwright test --config=playwright.fixtures-behavior.config.ts --workers=2 && npm run test:ui:playback -- --workers=2 && npm run test:ui:music-qol -- --workers=2 && npm run test:ui:player-qol -- --workers=2",
    "test:ui:visual": "npm run test:ui -- --workers=2 && playwright test --config=playwright.fixtures-visual.config.ts --workers=2",
    "test:ui:live": "playwright test --config=playwright.live.config.ts",
    "test:ui:fixtures": "playwright test --config=playwright.fixtures.config.ts",
    "test:ui:fixtures:update": "playwright test --config=playwright.fixtures.config.ts --update-snapshots",
    "test:ui:update": "playwright test --update-snapshots",
    "test:users:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.test-users.local scripts/seed-test-users.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/server": "^1.4.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.3.3",
    "@twemoji/api": "^17.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "express": "^5.1.0",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.13.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  }
}
